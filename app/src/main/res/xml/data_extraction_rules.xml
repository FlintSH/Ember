<?xml version="1.0" encoding="utf-8"?>
<!--
  Ember keeps its token in the Android Keystore, which never leaves the device,
  so a backup could not restore the connection anyway. Nothing is backed up or
  copied to a new phone. Reconnect Ember after moving devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
